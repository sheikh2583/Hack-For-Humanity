# Copy these keys into Streamlit Cloud -> App settings -> Secrets (or a local .streamlit/secrets.toml).
# Never commit real passcodes. With no passcode set, staff sign-in is disabled and everyone is public.
staff_passcode_inspector = "change-me-inspector"
staff_passcode_admin = "change-me-admin"
# Optional: shows a "Demo as: Public / Inspector / Admin" switcher in the Staff menu (pitch only).
demo_mode = false
