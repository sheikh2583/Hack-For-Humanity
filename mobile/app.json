{
  "expo": {
    "name": "KilnWatch BD",
    "slug": "kilnwatch-bd",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-location",
      "expo-camera"
    ],
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Show nearby kiln candidates.",
        "NSCameraUsageDescription": "Capture a field photo."
      }
    }
  }
}
